<!DOCTYPE html>
<html lang="en" dir="ltr">
    <head>
        <!-- prettier-ignore -->
        <%- include('./_partials/_head'); %>
        <%- include('./_partials/_cdn_datatables'); %>
        <%- include('./_partials/_cdn_googlecharts'); %>
        <!-- prettier-ignore -->
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(drawChart1);
            google.charts.setOnLoadCallback(drawChart2);

            function drawChart1() {
                fetch(`<%= baseURL %>/api/distribution_of_chronic_sick`)
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Kronik Hastalık", "Yüzde"]];

                        data.distribution_of_chronic_sick.forEach((item) => {
                            chartData.push([item.chronic_name, parseInt(item.number)]);
                        });

                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            chartArea: {
                                top: 25,
                                right: 25,
                                bottom: 25,
                                left: 75,
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("chart_div1")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }
            function drawChart2() {
                fetch(`<%= baseURL %>/api/gender_distribution_of_chronic_sick`)
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Kronik Hastalık - Cinsiyet", "Yüzde"]];

                        data.gender_distribution_of_chronic_sick.forEach((item) => {
                            chartData.push([item.chronic_name + " - " + item.gender_name, parseInt(item.number)]);
                        });

                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            chartArea: {
                                top: 25,
                                right: 25,
                                bottom: 25,
                                left: 75,
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("chart_div2")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }
        </script>
    </head>
    <body class="navbar-fixed sidebar-fixed" id="body">
        <div class="wrapper">
            <%- include('_partials/_sidebar') %>
            <div class="page-wrapper">
                <%- include('./_partials/_header') %>
                <div class="content-wrapper">
                    <div class="content">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pt-3"
                                            style="
                                                font-size: 25px;
                                                font-weight: bold;
                                            "
                                        >
                                            Kronik Hastalıkların Dağılımı
                                        </h1>
                                        <div
                                            id="chart_div1"
                                            style="
                                                min-width: 100%;
                                                height: 50vh;
                                            "
                                        ></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pt-3"
                                            style="
                                                font-size: 25px;
                                                font-weight: bold;
                                            "
                                        >
                                            Kronik Hastalıkların Cinsiyet
                                            Dağılımı
                                        </h1>
                                        <div
                                            id="chart_div2"
                                            style="
                                                min-width: 100%;
                                                height: 50vh;
                                            "
                                        ></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 mt-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pt-3"
                                            style="
                                                font-size: 24px;
                                                font-weight: bold;
                                            "
                                        >
                                            Kronik Hasta Bilgileri
                                        </h1>
                                        <table
                                            id="table_chronic_sick"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        Hasta ID
                                                    </th>
                                                    <th>Ad</th>
                                                    <th>Soyad</th>
                                                    <th class="text-center">
                                                        Cinsiyet
                                                    </th>
                                                    <th class="text-center">
                                                        Yaş
                                                    </th>
                                                    <th>Kronik Hastalık</th>
                                                    <th class="text-center">
                                                        Sil
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% info_chronic_sick.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center"><%= item.sick_id %></td>
                                                    <td><%= item.sick_name %></td>
                                                    <td><%= item.sick_surname %></td>
                                                    <td class="text-center"><%= item.gender_name %></td>
                                                    <td class="text-center"><%= item.sick_age %></td>
                                                    <td><%= item.chronic_name %></td>
                                                    <td class="text-danger text-center">
                                                        <a href="<%= baseURL %>/sick/delete_chronic/<%= item.sick_chronic_id %>" class="btn btn-outline-danger">Sil</a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 mt-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pb-3"
                                            style="
                                                font-size: 25px;
                                                font-weight: bold;
                                            "
                                        >
                                            Hasta İçin Kronik Hastalık Ekleme
                                            Formu
                                        </h1>
                                        <form
                                            action="<%= baseURL %>/sick/create_chronic"
                                            method="post"
                                        >
                                            <div class="form-group">
                                                <label for="sick_id"
                                                    >Hasta Adı</label
                                                >
                                                <select
                                                    class="form-control"
                                                    id="sick_id"
                                                    name="sick_id"
                                                    required
                                                >
                                                    <option value=""></option>
                                                    <!-- prettier-ignore -->
                                                    <% list_sick.forEach(item => { %>
                                                    <!-- prettier-ignore -->
                                                    <option value="<%= item.sick_id %>">
                                                        <%= `${item.sick_name} ${item.sick_surname}` %>
                                                    </option>
                                                    <% }) %>
                                                </select>
                                            </div>

                                            <div class="form-group">
                                                <label for="chronic_id"
                                                    >Kronik Hastalık</label
                                                >
                                                <select
                                                    class="form-control"
                                                    id="chronic_id"
                                                    name="chronic_id"
                                                    required
                                                >
                                                    <option value=""></option>
                                                    <!-- prettier-ignore -->
                                                    <% list_chronic.forEach(item => { %>
                                                    <!-- prettier-ignore -->
                                                    <option value="<%= item.chronic_id %>">
                                                        <%= item.chronic_name %>
                                                    </option>
                                                    <% }) %>
                                                </select>
                                            </div>

                                            <div class="form-group">
                                                <button
                                                    type="submit"
                                                    class="btn btn-lg btn-success"
                                                >
                                                    Ekle
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 mt-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center mb-5"
                                            style="
                                                font-size: 25px;
                                                font-weight: bold;
                                            "
                                        >
                                            Kronik Hastalık Ekleme Formu
                                        </h1>
                                        <form
                                            action="<%= baseURL %>/chronic/create"
                                            method="post"
                                            class="d-flex align-items-center"
                                        >
                                            <input
                                                name="chronic_name"
                                                class="form-control"
                                                type="text"
                                                placeholder="Kronik Hastalık"
                                            />
                                            <button
                                                type="submit"
                                                class="btn btn-success"
                                            >
                                                Ekle
                                            </button>
                                        </form>
                                    </div>

                                    <hr />

                                    <div class="card-body">
                                        <h1
                                            class="text-center pb-3"
                                            style="
                                                font-size: 24px;
                                                font-weight: bold;
                                            "
                                        >
                                            Kronik Hastalıklar Listesi
                                        </h1>
                                        <table
                                            id="table_chronic_list"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        ID
                                                    </th>
                                                    <th>Hastalık Adı</th>
                                                    <th class="text-center">
                                                        Sil
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% list_chronic.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center"><%= item.chronic_id %></td>
                                                    <td><%= item.chronic_name %></td>
                                                    <td class="text-danger text-center">
                                                        <a href="<%= baseURL %>/chronic/delete/<%= item.chronic_id %>" class="btn btn-outline-danger">Sil</a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <%- include('./_partials/_footer') %>
            </div>
        </div>
        <%- include('./_partials/_scripts') %>
        <script>
            new DataTable("#table_chronic_sick", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[0, "desc"]],
            });
            new DataTable("#table_chronic_list", {
                paging: false,
                scrollCollapse: true,
                scrollY: "25vh",
                order: [[0, "desc"]],
            });
        </script>
    </body>
</html>
