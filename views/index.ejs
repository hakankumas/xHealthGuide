<!DOCTYPE html>
<html lang="en" dir="ltr">
    <head>
        <!-- prettier-ignore -->
        <%- include('./_partials/_head'); %>
        <%- include('./_partials/_cdn_datatables'); %>
        <%- include('./_partials/_cdn_googlecharts'); %>
        <!-- prettier-ignore -->
    </head>
    <body class="navbar-fixed sidebar-fixed" id="body">
        <div class="wrapper">
            <%- include('_partials/_sidebar') %>
            <div class="page-wrapper">
                <%- include('./_partials/_header') %>
                <div class="content-wrapper">
                    <div class="content">
                        <div class="row">
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-success rounded-circle mr-3"
                                        >
                                            <i
                                                class="mdi mdi-account-plus-outline"
                                            ></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Hasta Sayısı</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-secondary rounded-circle mr-3"
                                        >
                                            <i class="mdi mdi-table-edit"></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Kronik Hasta</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick_by_chronic[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-info rounded-circle mr-3"
                                        >
                                            <i class="mdi mdi-human-male"></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Erkek Hasta</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick_by_male[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-primary rounded-circle mr-3"
                                        >
                                            <i class="mdi mdi-human-female"></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Kadın Hasta</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick_by_female[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pt-3"
                                            style="
                                                font-size: 24px;
                                                font-weight: bold;
                                            "
                                        >
                                            Hastaların Vücut Kitle Endeksi ve
                                            Obezite Durumları
                                        </h1>
                                        <table
                                            id="table_sick"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        ID
                                                    </th>
                                                    <th>Ad</th>
                                                    <th>Soyad</th>
                                                    <th class="text-center">
                                                        Cinsiyet
                                                    </th>
                                                    <th class="text-center">
                                                        Yaş
                                                    </th>
                                                    <th class="text-center">
                                                        Boy
                                                    </th>
                                                    <th class="text-center">
                                                        Kilo
                                                    </th>
                                                    <th class="text-center">
                                                        Vücut Kitle Endeksi
                                                    </th>
                                                    <th class="text-center">
                                                        Durum
                                                    </th>
                                                    <th class="text-center">
                                                        Kronik Hastalık
                                                    </th>
                                                    <th class="text-center">
                                                        Sil
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% info_sick.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center"><%= item.sick_id %></td>
                                                    <td><%= item.sick_name %></td>
                                                    <td><%= item.sick_surname %></td>
                                                    <td class="text-center"><%= item.gender_name %></td>
                                                    <td class="text-center"><%= item.sick_age %></td>
                                                    <td class="text-center"><%= item.sick_height %> cm</td>
                                                    <td class="text-center"><%= item.sick_weight %> kg</td>
                                                    <td class="text-center"><%= item.sick_bmi %> bmi</td>
                                                    <td class="text-center <%= (item.sick_bmi < 25) ? 'text-success' : (item.sick_bmi > 30 ? 'text-danger' : 'text-primary') %>">
                                                        <%= (item.sick_bmi < 25) ? 'İdeal' : (item.sick_bmi > 30 ? 'Obez' : 'Fazla Kilolu') %>
                                                    </td>
                                                    <td class="text-center <%= (item.chronic_number != 0) ? 'text-info' : 'text-dark' %>">
                                                        <%= (item.chronic_number != 0) ? `${item.chronic_number} Kronik Hastalık` : '-' %>
                                                    </td>
                                                    <td class="text-danger text-center">
                                                        <a href="<%= baseURL %>/sick/delete/<%= item.sick_id %>" class="btn btn-outline-danger">Sil</a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <%- include('./_partials/_footer') %>
            </div>
        </div>
        <%- include('./_partials/_scripts') %>
        <script>
            new DataTable("#table_sick", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[0, "desc"]],
            });
        </script>
    </body>
</html>
