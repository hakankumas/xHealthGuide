<!DOCTYPE html>
<html lang="en" dir="ltr">
    <head>
        <!-- prettier-ignore -->
        <%- include('./_partials/_head'); %>
        <%- include('./_partials/_cdn_datatables'); %>
        <%- include('./_partials/_cdn_googlecharts'); %>
        <!-- prettier-ignore -->

        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(fetchDataAndDrawChart);

            async function fetchDataAndDrawChart() {
                try {
                    const response = await fetch(
                        `<%= baseURL %>/api/sick_bmi`
                    );
                    const result = await response.json();

                    const chartData = [
                        ["Hasta Adı", "BMI", { role: "style" }],
                    ];
                    result.sick_bmi.forEach((item) => {
                        const color = generateColor();
                        chartData.push([
                            item.sick_fullname,
                            parseFloat(item.sick_bmi),
                            color,
                        ]);
                    });

                    const data =
                        google.visualization.arrayToDataTable(chartData);

                    const options = {
                        hAxis: {
                            title: "Hasta Bilgisi",
                        },
                        vAxis: {
                            title: "BMI Değeri",
                        },
                        legend: { position: "none" },
                        chartArea: {
                            top: 40,
                            bottom: 120,
                        },
                    };

                    const chart = new google.visualization.ColumnChart(
                        document.getElementById("chart_div")
                    );

                    chart.draw(data, options);
                } catch (error) {
                    console.error("Veri çekilirken hata oluştu:", error);
                }
            }

            // Rastgele renk oluşturma fonksiyonu
            function generateColor() {
                const letters = "0123456789ABCDEF";
                let color = "#";
                for (let i = 0; i < 6; i++) {
                    color += letters[Math.floor(Math.random() * 16)];
                }
                return color;
            }
        </script>
    </head>
    <body class="navbar-fixed sidebar-fixed" id="body">
        <div class="wrapper">
            <%- include('_partials/_sidebar') %>
            <div class="page-wrapper">
                <%- include('./_partials/_header') %>
                <div class="content-wrapper">
                    <div class="content">
                        <div class="row">
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-success rounded-circle mr-3"
                                        >
                                            <i
                                                class="mdi mdi-account-plus-outline"
                                            ></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Hasta Sayısı</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-secondary rounded-circle mr-3"
                                        >
                                            <i
                                                class="mdi mdi-account-alert"
                                            ></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Kronik Hasta</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick_by_chronic[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-info rounded-circle mr-3"
                                        >
                                            <i class="mdi mdi-human-male"></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Erkek Hasta</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick_by_male[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="card card-default">
                                    <div class="d-flex p-5">
                                        <div
                                            class="icon-md bg-primary rounded-circle mr-3"
                                        >
                                            <i class="mdi mdi-human-female"></i>
                                        </div>
                                        <div class="text-left">
                                            <!-- prettier-ignore -->
                                            <span class="h4 d-block">Kadın Hasta</span>
                                            <!-- prettier-ignore -->
                                            <p class="h2"><%= count_sick_by_female[0].number %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pt-3"
                                            style="
                                                font-size: 25px;
                                                font-weight: bold;
                                            "
                                        >
                                            Hastaların Vücut Kitle Endeksleri
                                        </h1>
                                        <div
                                            id="chart_div"
                                            style="
                                                min-width: 100%;
                                                height: 60vh;
                                            "
                                        ></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pt-3"
                                            style="
                                                font-size: 24px;
                                                font-weight: bold;
                                            "
                                        >
                                            Hastaların Sağlık Durumları
                                        </h1>
                                        <table
                                            id="table_sick"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        ID
                                                    </th>
                                                    <th>Ad</th>
                                                    <th>Soyad</th>
                                                    <th class="text-center">
                                                        Cinsiyet
                                                    </th>
                                                    <th class="text-center">
                                                        Yaş
                                                    </th>
                                                    <th class="text-center">
                                                        Boy
                                                    </th>
                                                    <th class="text-center">
                                                        Kilo
                                                    </th>
                                                    <th class="text-center">
                                                        Vücut Kitle Endeksi
                                                    </th>
                                                    <th class="text-center">
                                                        Durum
                                                    </th>
                                                    <th class="text-center">
                                                        Kronik Hastalık
                                                    </th>
                                                    <th class="text-center">
                                                        Sil
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% info_sick.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center"><%= item.sick_id %></td>
                                                    <td><%= item.sick_name %></td>
                                                    <td><%= item.sick_surname %></td>
                                                    <td class="text-center"><%= item.gender_name %></td>
                                                    <td class="text-center"><%= item.sick_age %></td>
                                                    <td class="text-center"><%= item.sick_height %> cm</td>
                                                    <td class="text-center"><%= item.sick_weight %> kg</td>
                                                    <td class="text-center"><%= item.sick_bmi %> bmi</td>
                                                    <td class="text-center <%= (item.sick_bmi < 25) ? 'text-success' : (item.sick_bmi > 30 ? 'text-danger' : 'text-primary') %>">
                                                        <%= (item.sick_bmi < 25) ? 'İdeal' : (item.sick_bmi > 30 ? 'Obez' : 'Fazla Kilolu') %>
                                                    </td>
                                                    <td class="text-center <%= (item.chronic_number != 0) ? 'text-info' : 'text-dark' %>">
                                                        <%= (item.chronic_number != 0) ? `${item.chronic_number} Kronik Hastalığı Var` : '-' %>
                                                    </td>
                                                    <td class="text-danger text-center">
                                                        <a href="<%= baseURL %>/sick/delete/<%= item.sick_id %>" class="btn btn-outline-danger">Sil</a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-body">
                                        <h1
                                            class="text-center pb-3"
                                            style="
                                                font-size: 25px;
                                                font-weight: bold;
                                            "
                                        >
                                            Hasta Ekleme Formu
                                        </h1>
                                        <form
                                            action="<%= baseURL %>/sick/create"
                                            method="post"
                                        >
                                            <div class="form-group">
                                                <label for="name">Ad</label>
                                                <input
                                                    id="name"
                                                    name="name"
                                                    class="form-control"
                                                    type="text"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <label for="surname"
                                                    >Soyad</label
                                                >
                                                <input
                                                    id="surname"
                                                    name="surname"
                                                    class="form-control"
                                                    type="text"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <label for="gender_id"
                                                    >Cinsiyet</label
                                                >
                                                <select
                                                    class="form-control"
                                                    id="gender_id"
                                                    name="gender_id"
                                                    required
                                                >
                                                    <option value=""></option>
                                                    <option value="1">
                                                        Erkek
                                                    </option>
                                                    <option value="2">
                                                        Kadın
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="form-group">
                                                <label for="birthday"
                                                    >Doğum Tarih</label
                                                >
                                                <input
                                                    id="birthday"
                                                    name="birthday"
                                                    class="form-control"
                                                    type="date"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <label for="height">Boy</label>
                                                <input
                                                    id="height"
                                                    name="height"
                                                    class="form-control"
                                                    type="text"
                                                    placeholder="Örn: 185"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <label for="weight">Kilo</label>
                                                <input
                                                    id="weight"
                                                    name="weight"
                                                    class="form-control"
                                                    type="text"
                                                    placeholder="Örn: 85"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <button
                                                    type="submit"
                                                    class="btn btn-lg btn-success"
                                                >
                                                    Ekle
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <%- include('./_partials/_footer') %>
            </div>
        </div>
        <%- include('./_partials/_scripts') %>
        <script>
            new DataTable("#table_sick", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[0, "desc"]],
            });
        </script>
    </body>
</html>
