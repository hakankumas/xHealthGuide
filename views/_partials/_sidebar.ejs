<aside class="left-sidebar sidebar-dark" id="left-sidebar">
    <div id="sidebar" class="sidebar sidebar-with-footer">
        <div class="app-brand">
            <a href="<%= baseURL %>/">
                <img src="./logo.png" style="width: 50px" />
                <span class="brand-name">Sağlık Rehberi</span>
            </a>
        </div>
        <div class="sidebar-left" data-simplebar style="height: 100%">
            <ul class="nav sidebar-inner" id="sidebar-menu">
                <li class="<%= activePage === 'dashboard' ? 'active' : '' %>">
                    <a class="sidenav-item-link" href="<%= baseURL %>/">
                        <i class="mdi mdi-home-account"></i>
                        <span class="nav-text">Dashboard</span>
                    </a>
                </li>

                <li class="<%= activePage === 'chronic' ? 'active' : '' %>">
                    <a class="sidenav-item-link" href="<%= baseURL %>/chronic">
                        <i class="mdi mdi-alert-circle-outline"></i>
                        <span class="nav-text">Kronik Hastalar</span>
                    </a>
                </li>

                <li class="<%= activePage === 'male' ? 'active' : '' %>">
                    <a class="sidenav-item-link" href="<%= baseURL %>/male">
                        <i class="mdi mdi-human-male"></i>
                        <span class="nav-text">Erkek Hastalar</span>
                    </a>
                </li>

                <li class="<%= activePage === 'female' ? 'active' : '' %>">
                    <a class="sidenav-item-link" href="<%= baseURL %>/female">
                        <i class="mdi mdi-human-female"></i>
                        <span class="nav-text">Kadın Hastalar</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</aside>
