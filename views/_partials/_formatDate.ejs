<script>
    function formatDate(dateString) {
        const date = new Date(dateString);
        const day = String(date.getDate()).padStart(2, "0");
        const month = String(date.getMonth() + 1).padStart(2, "0"); // Aylar 0'dan başlıyor
        const year = String(date.getFullYear()).slice(-2); // Son iki haneyi al
        return `${day}-${month}-${year}`;
    }
</script>
